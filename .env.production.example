APP_NAME=Discord Verification API
APP_ENVIRONMENT=production
DEBUG=false

API_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME

# Public HTTPS URLs
FRONTEND_URL=https://verify.example.com
BACKEND_URL=https://api.verify.example.com

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.verify.example.com/api/auth/discord/callback

DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize
DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token
DISCORD_OAUTH_SCOPE=identify

DISCORD_OAUTH_STATE_TTL_SECONDS=600
VERIFICATION_SESSION_TTL_MINUTES=30

# Mobile QR/camera capture
MOBILE_CAPTURE_TTL_MINUTES=10
MOBILE_CAPTURE_COOKIE_NAME=mobile_capture_session

# Cryptographically random production secret.
# Generate separately. Never commit the real value.
SESSION_SECRET=

# Cryptographically random verification-token pepper.
VERIFICATION_TOKEN_PEPPER=

VERIFICATION_TOKEN_BYTES=32
VERIFICATION_DEFAULT_EXPIRY_HOURS=24
VERIFICATION_MAX_SUBMISSIONS=1

# Evidence
EVIDENCE_MAX_FILE_SIZE_BYTES=10485760
EVIDENCE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf

TEMPORARY_UPLOAD_TTL_MINUTES=60
EVIDENCE_SIGNED_URL_TTL_SECONDS=300

# Private S3-compatible object storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Discord controlled-access configuration
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_CHANNEL_ID=

DISCORD_INVITE_MAX_AGE_SECONDS=900
DISCORD_INVITE_MAX_USES=1

# Encryption key used for protected access-grant data
ACCESS_GRANT_ENCRYPTION_KEY=

# External administrator OIDC provider
ADMIN_AUTH_ISSUER=https://YOUR-IDP/
ADMIN_AUTH_AUDIENCE=
ADMIN_AUTH_JWKS_URL=https://YOUR-IDP/.well-known/jwks.json
ADMIN_AUTH_REQUIRED_MFA=true

# Browser/API origin restrictions
ALLOWED_ORIGINS=https://verify.example.com

# Host header allow-list.
# Hostnames only — no https:// and no paths.
ALLOWED_HOSTS=api.verify.example.com

# Managed Redis
# Prefer TLS where provider supports it:
# rediss://...
REDIS_URL=

RATE_LIMITING_ENABLED=true

PUBLIC_REQUEST_RATE_LIMIT=60
OAUTH_START_RATE_LIMIT=15
EVIDENCE_UPLOAD_RATE_LIMIT=20
SUBMISSION_RATE_LIMIT=10
ADMIN_API_RATE_LIMIT=120

ADMIN_SENSITIVE_REAUTH_MAX_AGE_SECONDS=900

# Cookies must be HTTPS-only in production
COOKIE_SECURE=true

# Leave empty unless frontend/backend cookie design
# explicitly requires a shared parent domain.
COOKIE_DOMAIN=

CSRF_COOKIE_NAME=verification_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_BYTES=32